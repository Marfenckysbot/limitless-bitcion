# Local development only. Do not commit .env.local or real credentials.

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/luxurygold"

# Auth
NEXTAUTH_SECRET="replace-with-a-local-random-secret"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED="false"

# Provider placeholders — no live integrations are enabled by default.
STRIPE_PUBLIC_KEY="pk_test_placeholder"
STRIPE_SECRET_KEY="sk_test_placeholder"
COINBASE_API_KEY="replace-me"
COINGECKO_API_KEY="replace-me"

# Storage placeholders
CLOUDINARY_CLOUD_NAME="replace-me"
CLOUDINARY_API_KEY="replace-me"
CLOUDINARY_API_SECRET="replace-me"

# Webhook signing placeholder
HMAC_SECRET="replace-with-a-local-only-secret"

# Feature flags
# Mock values are for local development and are labelled DEMO by the API.
USE_MOCK_PROVIDERS="true"
# Keep real conversion disabled unless a live provider and settlement flow are integrated.
ENABLE_BTC_CONVERSION="false"
ENABLE_LIVE_VIDEO="false"

# These settings are reserved; distributed rate limiting is not yet implemented.
QUOTE_EXPIRY_SECONDS="900"
COURIER_QUOTE_EXPIRY_SECONDS="900"
HTTP_TIMEOUT_MS="15000"
HTTP_MAX_RETRIES="3"
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW_MS="60000"
