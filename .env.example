# Database
DATABASE_URL="postgresql://user:password@localhost:5432/luxurygold"

# Auth
NEXTAUTH_SECRET="your-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# APIs
STRIPE_PUBLIC_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
COINBASE_API_KEY="..."
COINGECKO_API_KEY="..."

# Storage
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."

# Security
HMAC_SECRET="your-webhook-signing-secret"

# Feature Flags
USE_MOCK_PROVIDERS="true"
ENABLE_BTC_CONVERSION="true"
ENABLE_LIVE_VIDEO="true"

# Timeouts and Limits
QUOTE_EXPIRY_SECONDS="86400"
COURIER_QUOTE_EXPIRY_SECONDS="900"
HTTP_TIMEOUT_MS="15000"
HTTP_MAX_RETRIES="3"
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW_MS="60000"
