# Database
DATABASE_URL="postgresql://user:password@localhost:5432/luxurygold_dev"

# Auth
NEXTAUTH_SECRET="your-development-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Payment
STRIPE_PUBLIC_KEY="pk_test_your_stripe_public_key"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"

# Crypto
COINBASE_API_KEY="your-coinbase-api-key"
COINGECKO_API_KEY="your-coingecko-api-key"

# Storage
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Security
HMAC_SECRET="your-webhook-signing-secret"

# Feature Flags
USE_MOCK_PROVIDERS="true"
ENABLE_BTC_CONVERSION="true"
ENABLE_LIVE_VIDEO="true"

# Timeouts and Limits
QUOTE_EXPIRY_SECONDS="86400"
COURIER_QUOTE_EXPIRY_SECONDS="900"
HTTP_TIMEOUT_MS="15000"
HTTP_MAX_RETRIES="3"
RATE_LIMIT_MAX="100"
RATE_LIMIT_WINDOW_MS="60000"