generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?   @db.VarChar(255)
  role           Role      @default(USER)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  shipments     Shipment[]
  orders        Order[]
  kycRecord     KYCRecord?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Shipment {
  id            String    @id @default(cuid())
  userId        String
  declaredValue Decimal   @db.Decimal(10, 2)
  tier          ShipmentTier
  status        ShipmentStatus
  pickupToken   String?
  quote         Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User       @relation(fields: [userId], references: [id])
  events        ShipmentEvent[]
  items         Item[]
}

model ShipmentEvent {
  id          String    @id @default(cuid())
  shipmentId  String
  type        String
  metadata    Json?
  createdAt   DateTime  @default(now())

  shipment    Shipment  @relation(fields: [shipmentId], references: [id])
}

model Item {
  id          String    @id @default(cuid())
  type        ItemType
  weight      Decimal?  @db.Decimal(10, 3)
  karat       Int?
  description String?
  photos      String[]
  shipmentId  String?
  orderId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  shipment    Shipment? @relation(fields: [shipmentId], references: [id])
  order       Order?    @relation(fields: [orderId], references: [id])
}

model Order {
  id          String    @id @default(cuid())
  userId      String
  status      OrderStatus
  totalAmount Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id])
  items       Item[]
}

model KYCRecord {
  id          String    @id @default(cuid())
  userId      String    @unique
  status      KYCStatus
  level       KYCLevel
  documents   Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id])
}

enum Role {
  USER
  ADMIN
  COURIER
}

enum ShipmentTier {
  STANDARD
  WHITE_GLOVE
  VIP
  VAULT
  INTERNATIONAL
}

enum ShipmentStatus {
  PENDING
  CONFIRMED
  PICKUP_ASSIGNED
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
}

enum ItemType {
  GOLD_BAR
  GOLD_COIN
  JEWELRY
  OTHER
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

enum KYCStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum KYCLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
}
